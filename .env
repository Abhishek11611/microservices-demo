# =========================
# DATABASE CONFIG
# =========================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=demodb
DB_USERNAME=postgres
DB_PASSWORD=StrongPassword@123

# =========================
# SPRING PROFILE
# =========================
SPRING_PROFILES_ACTIVE=docker

# =========================
# JWT KEYS (Paths inside container or mounted volume)
# =========================
JWT_PRIVATE_KEY=classpath:private.pem
JWT_PUBLIC_KEY=classpath:public.pem

JWT_ENCRYPTION_PRIVATE_KEY=classpath:encryption-private.pem
JWT_ENCRYPTION_PUBLIC_KEY=classpath:encryption-public.pem